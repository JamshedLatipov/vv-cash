bin/
obj/

# Build outputs. Note build/* rather than build/: the installer sources live under
# build/installer/ and have to stay tracked, and git will not descend into an
# excluded directory to reach a negation.
out/
publish/
TestResults/
build/*
!build/installer/
build/installer/Output/

# Rider / JetBrains
.idea/
*.sln.iml

# Visual Studio / VS Code local settings
.vs/
.vscode/
*.user
*.rsuser
*.suo

# NuGet and package cache artifacts
packages/
*.nupkg
*.snupkg

# Logs and runtime generated files
*.log
*.tmp

# OS generated files
.DS_Store
Thumbs.db

IconTest.*
test.*

# Server details for build/installer/release.ps1 -Publish. Local only.
build/installer/publish.local.json
