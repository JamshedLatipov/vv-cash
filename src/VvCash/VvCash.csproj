<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>VvCash</RootNamespace>
    <AssemblyName>VvCash</AssemblyName>
    <!-- Single source of the product version: the installer script reads it from here
         and passes it to ISCC, and IAppVersionProvider reads it back off the built
         assembly at run time. Bump this line to cut a release. -->
    <Version>1.0.16</Version>
    <!-- Audit transitive packages too, and fail the build rather than warn: the
         e_sqlite3 advisory below sat in the log as a warning through several
         releases because nothing was watching for NU19xx. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="Avalonia.ReactiveUI" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Material.Icons" Version="2.1.9" />
    <PackageReference Include="Material.Icons.Avalonia" Version="2.1.9" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <!-- Security override: transitive Tmds.DBus.Protocol 0.20.0 (via Avalonia.FreeDesktop) has GHSA-xrw6-gwf8-vvr9. Pin to patched 0.21.3. Linux D-Bus path only; no Windows impact. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <!-- Security override: transitive SQLitePCLRaw 2.1.11 (via Microsoft.Data.Sqlite 10.0.5)
         carries GHSA-2m69-gcr7-jv3q in the native e_sqlite3 build. Pin the bundle to 2.1.12,
         which brings lib/core/provider along with it. Stays on 2.1.x rather than 3.x:
         Microsoft.Data.Sqlite.Core 10.0.5 resolves against that line, and this is the
         register's own product database — not somewhere to take an untested major bump. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- Kestrel для локального сервера очереди. Publish self-contained, значит
         рантайм ASP.NET Core уезжает внутрь сборки: +27,9 МБ на win-x64 и
         +26,2 МБ на win-x86, со 113 до 141 МБ — измерено сравнением публикаций
         до и после, а не оценкой. Это цена каждого автообновления на каждой
         кассе, и она принята сознательно: HttpListener из BCL не весит ничего,
         но требует netsh http add urlacl под конкретный порт при установке, а
         смена порта в настройках после этого молча перестаёт работать. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Экраны очереди едут внутри сборки, а не файлами рядом с exe: иначе
         автообновление разъедется с кодом, и на точке после обновления
         останется вчерашняя страница поверх сегодняшнего QueueServer.
         Assets/Web/* уже накрыт AvaloniaResource выше (Assets/**) — это не
         конфликт: AvaloniaResource и EmbeddedResource это два независимых
         списка элементов сборки с разными типами, один даёт avares://,
         другой — Assembly.GetManifestResourceStream, файл спокойно состоит
         в обоих. -->
    <EmbeddedResource Include="Assets/Web/*" />
  </ItemGroup>
  <ItemGroup>
    <!-- Lets VvCash.Tests reach CompositePrinterService.Printers, the read-only
         snapshot that lets a test see which EscPosCodePage each printer actually
         got. Internal, not public: it keeps the snapshot off the public API surface
         and marks it as not meant for production use. It does not stop production
         code from reaching it: internal is visible to every file in this assembly,
         and EscPosPrinterService is itself public regardless. Real enforcement
         would need an analyser, which this is not worth. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>VvCash.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
