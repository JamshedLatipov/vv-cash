<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:VvCash.Services"
        xmlns:vm="using:VvCash.ViewModels"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:converters="using:VvCash.Converters"
        x:Class="VvCash.Views.MixedPaymentView"
        x:Name="RootWindow"
        Background="{StaticResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:StringEqualityToBoolConverter x:Key="StringEqualityToBoolConverter"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- payment method tile -->
        <Style Selector="Button.MethodTile">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Slate600Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Slate200Brush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="8,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.MethodTile:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Slate50Brush}"/>
        </Style>
        <Style Selector="Button.MethodTile.Active">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Style>
        <Style Selector="Button.MethodTile.Active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>

        <!-- keypad -->
        <Style Selector="Button.PayKey">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Slate900Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Slate100Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style Selector="Button.PayKey:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Slate50Brush}"/>
        </Style>
        <Style Selector="Button.PayKey:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.PayKeyAction">
            <Setter Property="Background" Value="{StaticResource Slate100Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource Slate700Brush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <Style Selector="Button.PayKeyAction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Slate200Brush}"/>
        </Style>
        <Style Selector="Button.PayKeyAction:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="TextElement.Foreground" Value="White"/>
        </Style>

        <!-- quick tender chips -->
        <Style Selector="Button.QuickBtn">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource Slate700Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Slate200Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.QuickBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryBrush}"/>
        </Style>

        <!-- eyebrow labels -->
        <Style Selector="TextBlock.Eyebrow">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource Slate400Brush}"/>
        </Style>

        <!-- keyboard hint chip (dark, for primary button) -->
        <Style Selector="Border.KeyHintDark">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style Selector="Border.KeyHintDark > TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *" Background="{StaticResource BackgroundBrush}">
        <!-- ================= Header ================= -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,0,0,1" Padding="24,12">
            <Grid ColumnDefinitions="Auto, Auto, Auto, *, Auto">
                <Button Grid.Column="0" Classes="IconButton" Width="40" Height="40" Command="{Binding BackCommand}">
                    <material:MaterialIcon Kind="ArrowLeft" Width="22" Height="22"/>
                </Button>
                <Image Grid.Column="1" Source="avares://VvCash/Assets/logo.png" Width="28" Height="28" Stretch="Uniform" Margin="12,0,10,0"/>
                <TextBlock Grid.Column="2" Text="{Binding [Смешаннаяоплата], Source={x:Static services:I18nService.Instance}}" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource Slate900Brush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="{Binding [Заказ8824МодныйБутик], Source={x:Static services:I18nService.Instance}}" FontSize="13" Foreground="{StaticResource Slate400Brush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1" ColumnDefinitions="*, 380" Margin="20">

            <!-- LEFT: entry -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="20" Padding="20" Margin="0,0,20,0">
                <Grid RowDefinitions="Auto, Auto, *">
                    <!-- method tiles -->
                    <!-- Two tiles, not three: the sale document has exactly two money
                         slots (paid_in_cash, paid_by_credit_card). A gift-card tile used
                         to sit here and settle the receipt on screen while the document
                         went out saying the customer had paid nothing — see
                         MixedPaymentViewModel.PaidAmount. -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, *" Margin="0,0,0,16">
                        <Button Grid.Column="0" Classes="MethodTile" Margin="0,0,5,0"
                                Classes.Active="{Binding SelectedMethod, Converter={StaticResource StringEqualityToBoolConverter}, ConverterParameter='Cash'}"
                                Command="{Binding SelectMethodCommand}" CommandParameter="Cash">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <material:MaterialIcon Kind="Cash" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding [Наличные], Source={x:Static services:I18nService.Instance}}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Classes="MethodTile" Margin="5,0,0,0"
                                Classes.Active="{Binding SelectedMethod, Converter={StaticResource StringEqualityToBoolConverter}, ConverterParameter='Card'}"
                                Command="{Binding SelectMethodCommand}" CommandParameter="Card">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <material:MaterialIcon Kind="CreditCardOutline" Width="24" Height="24" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding [Банковскаякарта], Source={x:Static services:I18nService.Instance}}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- active amount display -->
                    <Border Grid.Row="1" Background="{StaticResource Slate50Brush}" CornerRadius="14" Padding="18,14" Margin="0,0,0,16">
                        <Grid ColumnDefinitions="Auto, *">
                            <TextBlock Grid.Column="0" Text="{Binding [БЫСТРЫЙВВОД], Source={x:Static services:I18nService.Instance}}" Classes="Eyebrow" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding QuickInputText}" FontSize="38" FontWeight="Black" LetterSpacing="-1" Foreground="{StaticResource Slate900Brush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- keypad | quick amounts -->
                    <Grid Grid.Row="2" ColumnDefinitions="*, *">
                        <!-- keypad -->
                        <Grid Grid.Column="0" RowDefinitions="*, *, *, *" ColumnDefinitions="*, *, *" Margin="-5,-5,8,-5">
                            <Button Grid.Row="0" Grid.Column="0" Classes="PayKey" Content="1" Command="{Binding AddDigitCommand}" CommandParameter="1"/>
                            <Button Grid.Row="0" Grid.Column="1" Classes="PayKey" Content="2" Command="{Binding AddDigitCommand}" CommandParameter="2"/>
                            <Button Grid.Row="0" Grid.Column="2" Classes="PayKey" Content="3" Command="{Binding AddDigitCommand}" CommandParameter="3"/>
                            <Button Grid.Row="1" Grid.Column="0" Classes="PayKey" Content="4" Command="{Binding AddDigitCommand}" CommandParameter="4"/>
                            <Button Grid.Row="1" Grid.Column="1" Classes="PayKey" Content="5" Command="{Binding AddDigitCommand}" CommandParameter="5"/>
                            <Button Grid.Row="1" Grid.Column="2" Classes="PayKey" Content="6" Command="{Binding AddDigitCommand}" CommandParameter="6"/>
                            <Button Grid.Row="2" Grid.Column="0" Classes="PayKey" Content="7" Command="{Binding AddDigitCommand}" CommandParameter="7"/>
                            <Button Grid.Row="2" Grid.Column="1" Classes="PayKey" Content="8" Command="{Binding AddDigitCommand}" CommandParameter="8"/>
                            <Button Grid.Row="2" Grid.Column="2" Classes="PayKey" Content="9" Command="{Binding AddDigitCommand}" CommandParameter="9"/>
                            <Button Grid.Row="3" Grid.Column="0" Classes="PayKeyAction" Content="C" Foreground="{StaticResource Red500Brush}" Command="{Binding ResetCommand}"/>
                            <Button Grid.Row="3" Grid.Column="1" Classes="PayKey" Content="0" Command="{Binding AddDigitCommand}" CommandParameter="0"/>
                            <Button Grid.Row="3" Grid.Column="2" Classes="PayKeyAction" Command="{Binding BackspaceCommand}">
                                <material:MaterialIcon Kind="BackspaceOutline" Width="24" Height="24"/>
                            </Button>
                        </Grid>

                        <!-- quick amounts -->
                        <Grid Grid.Column="1" RowDefinitions="Auto, *, *, Auto, *" Margin="8,0,0,0">
                            <TextBlock Grid.Row="0" Text="{Binding [QUICKAMOUNT], Source={x:Static services:I18nService.Instance}}" Classes="Eyebrow" Margin="0,0,0,8"/>
                            <Button Grid.Row="1" Classes="QuickBtn" Margin="0,0,0,8" Command="{Binding SetQuickAmountCommand}" CommandParameter="{Binding ExactAmount}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding [Exact], Source={x:Static services:I18nService.Instance}}" VerticalAlignment="Center"/>
                                    <TextBlock Text="·" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ExactAmount, StringFormat='{}{0:F2}'}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <ItemsControl Grid.Row="2" Grid.RowSpan="3" ItemsSource="{Binding RoundUpAmounts}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:Decimal">
                                        <Button Classes="QuickBtn" Margin="0,0,0,8" MinHeight="48"
                                                Command="{Binding $parent[ItemsControl].DataContext.SetQuickAmountCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding StringFormat='{}{0:F2}'}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT: receipt / confirm -->
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="20" Padding="22">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *, Auto">
                    <!-- subtotal -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" Text="{Binding [Общаясумма], Source={x:Static services:I18nService.Instance}}" FontSize="14" Foreground="{StaticResource Slate500Brush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalAmount, StringFormat='{}{0:F2}'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}"/>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{StaticResource Slate100Brush}" Margin="0,14"/>

                    <!-- total due -->
                    <StackPanel Grid.Row="2" Spacing="2">
                        <TextBlock Text="{Binding [TOTALDUE], Source={x:Static services:I18nService.Instance}}" Classes="Eyebrow"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat='{}{0:F2}'}" FontSize="40" FontWeight="Black" LetterSpacing="-1" Foreground="{StaticResource Slate900Brush}"/>
                    </StackPanel>

                    <Border Grid.Row="3" Height="1" Background="{StaticResource Slate100Brush}" Margin="0,16"/>

                    <!-- tender breakdown -->
                    <StackPanel Grid.Row="4" Spacing="12">
                        <Button Classes="Transparent" HorizontalAlignment="Stretch" Command="{Binding SelectMethodCommand}" CommandParameter="Cash">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <material:MaterialIcon Grid.Column="0" Kind="Cash" Width="18" Height="18" Foreground="{StaticResource Slate400Brush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding [Наличные], Source={x:Static services:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CashAmount, StringFormat='{}{0:F2}'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <Button Classes="Transparent" HorizontalAlignment="Stretch" Command="{Binding SelectMethodCommand}" CommandParameter="Card">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <material:MaterialIcon Grid.Column="0" Kind="CreditCardOutline" Width="18" Height="18" Foreground="{StaticResource Slate400Brush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding [Банковскаякарта], Source={x:Static services:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CardAmount, StringFormat='{}{0:F2}'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- progress + remaining / change -->
                    <StackPanel Grid.Row="5" Spacing="16" Margin="0,18,0,0">
                        <Panel>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" Height="8" CornerRadius="99"
                                         Background="{StaticResource Slate100Brush}" Foreground="{StaticResource PrimaryBrush}"
                                         IsVisible="{Binding !IsFullyPaid}"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="100" Height="8" CornerRadius="99"
                                         Background="{StaticResource Slate100Brush}" Foreground="{StaticResource SuccessBrush}"
                                         IsVisible="{Binding IsFullyPaid}"/>
                        </Panel>

                        <!-- remaining (red) -->
                        <Border Background="{StaticResource Red50Brush}" CornerRadius="16" Padding="18,14" IsVisible="{Binding !IsFullyPaid}">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Grid.Column="0" Text="{Binding [REMAINING], Source={x:Static services:I18nService.Instance}}" FontSize="13" FontWeight="Bold" LetterSpacing="0.5" Foreground="{StaticResource Red600Brush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding RemainingDue, StringFormat='{}{0:F2}'}" FontSize="30" FontWeight="Black" LetterSpacing="-0.5" Foreground="{StaticResource Red600Brush}"/>
                            </Grid>
                        </Border>
                        <!-- change / fully paid (green) -->
                        <Border Background="{StaticResource Emerald100Brush}" CornerRadius="16" Padding="18,14" IsVisible="{Binding IsFullyPaid}">
                            <Grid ColumnDefinitions="*, Auto">
                                <Panel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding [CHANGEDUE], Source={x:Static services:I18nService.Instance}}" FontSize="13" FontWeight="Bold" LetterSpacing="0.5" Foreground="{StaticResource Emerald600Brush}" IsVisible="{Binding HasChange}"/>
                                    <TextBlock Text="{Binding [FULLYPAID], Source={x:Static services:I18nService.Instance}}" FontSize="13" FontWeight="Bold" LetterSpacing="0.5" Foreground="{StaticResource Emerald600Brush}" IsVisible="{Binding !HasChange}"/>
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding ChangeAmount, StringFormat='{}{0:F2}'}" FontSize="30" FontWeight="Black" LetterSpacing="-0.5" Foreground="{StaticResource Emerald600Brush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- confirm / sell on credit -->
                    <StackPanel Grid.Row="7" Spacing="10">
                        <StackPanel Spacing="4" IsVisible="{Binding HasCustomer}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding [CurrentBalance], Source={x:Static services:I18nService.Instance}}"
                                           FontSize="13" Foreground="{StaticResource Slate500Brush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentBalanceDisplay, StringFormat='{}{0:F2}'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding [CreditLimit], Source={x:Static services:I18nService.Instance}}"
                                           FontSize="13" Foreground="{StaticResource Slate500Brush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding CreditLimitDisplay, StringFormat='{}{0:F2}'}"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}"/>
                            </Grid>
                            <TextBlock IsVisible="{Binding IsCreditBlocked}"
                                       Text="{Binding [CreditLimitExceeded], Source={x:Static services:I18nService.Instance}}"
                                       FontSize="12" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{StaticResource Red600Brush}"/>
                        </StackPanel>
                        <Button Classes="SecondaryButton" Height="52" CornerRadius="16" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Padding="22,0"
                                IsVisible="{Binding HasCustomer}"
                                Command="{Binding SellOnCreditCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <material:MaterialIcon Kind="AccountClock" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding [Продатьвдолг], Source={x:Static services:I18nService.Instance}}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="PrimaryButton" Height="60" CornerRadius="16" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" Padding="22,0"
                                Command="{Binding ConfirmPaymentCommand}">
                            <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                    <material:MaterialIcon Kind="CheckCircle" Width="24" Height="24" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding [Подтвердитьоплату], Source={x:Static services:I18nService.Instance}}" FontSize="17" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="2" Classes="KeyHintDark" VerticalAlignment="Center">
                                    <TextBlock Text="Enter"/>
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
