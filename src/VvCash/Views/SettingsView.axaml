<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="clr-namespace:VvCash.Services"
        xmlns:vm="using:VvCash.ViewModels"
        xmlns:models="using:VvCash.Models"
        xmlns:material="using:Material.Icons.Avalonia"
        x:Class="VvCash.Views.SettingsView"
        Background="{StaticResource Slate50Brush}">

    <UserControl.Styles>
        <Style Selector="Button.BackButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Slate600Brush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="Button.BackButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Slate200Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource Slate900Brush}"/>
        </Style>

        <Style Selector="Button.SaveButton">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0,16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.SaveButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#005fc4"/>
        </Style>

        <Style Selector="Button.AddButton">
            <Setter Property="Background" Value="{StaticResource Slate200Brush}"/>
            <Setter Property="Foreground" Value="{StaticResource Slate700Brush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>
        <Style Selector="Button.AddButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Slate300Brush}"/>
        </Style>

        <Style Selector="Button.DangerButton">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.DangerButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FEE2E2"/>
        </Style>

        <Style Selector="TextBox.SettingsInput">
            <Setter Property="Background" Value="{StaticResource Slate50Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Slate300Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource Slate900Brush}"/>
            <Setter Property="Margin" Value="0,8,0,24"/>
        </Style>
        <Style Selector="TextBox.SettingsInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style Selector="ComboBox.SettingsCombo">
            <Setter Property="Background" Value="{StaticResource Slate50Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Slate300Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource Slate900Brush}"/>
            <Setter Property="Margin" Value="0,8,0,24"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="TextBox.PrinterInput">
            <Setter Property="Background" Value="{StaticResource Slate50Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Slate300Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Slate900Brush}"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
        </Style>
        <Style Selector="TextBox.PrinterInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style Selector="ComboBox.PrinterCombo">
            <Setter Property="Background" Value="{StaticResource Slate50Brush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Slate300Brush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Slate900Brush}"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *" Height="{Binding $parent[Window].ClientSize.Height}">
        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <Button Grid.Column="0" Classes="BackButton" Command="{Binding GoBackCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="ArrowLeft" Width="24" Height="24"/>
                        <TextBlock Text="{Binding [BacktoLogin], Source={x:Static services:I18nService.Instance}}" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <!-- Central Title -->
                <TextBlock Grid.Column="1" Text="{Binding [SystemConfiguration], Source={x:Static services:I18nService.Instance}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" Padding="32,48,32,48" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" HorizontalAlignment="Center" Spacing="32" Margin="0,0,0,200">

                <!-- Header Description -->
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <material:MaterialIcon Kind="ServerNetwork" Width="64" Height="64" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding [ConnecttoCashRegiste], Source={x:Static services:I18nService.Instance}}" FontSize="28" FontWeight="Black" Foreground="{StaticResource Slate900Brush}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="{Binding [ConfiguretheAPIendpo], Source={x:Static services:I18nService.Instance}}" FontSize="16" Foreground="{StaticResource Slate500Brush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="500"/>
                </StackPanel>

                <!-- Configuration Card -->
                <Border Background="White" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="16" Padding="32" BoxShadow="0 4 6 0 #0D000000, 0 2 4 0 #0A000000">
                    <StackPanel>
                        <!-- Section Header -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,24">
                            <material:MaterialIcon Kind="Api" Width="24" Height="24" Foreground="{StaticResource Slate700Brush}"/>
                            <TextBlock Text="{Binding [APISettings], Source={x:Static services:I18nService.Instance}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Slate800Brush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Backend URL Input -->
                        <TextBlock Text="{Binding [BackendURL], Source={x:Static services:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}"/>
                        <TextBox Classes="SettingsInput" Text="{Binding BackendUrl, Mode=TwoWay}" Watermark="{Binding [httpsapivvcashcomv1], Source={x:Static services:I18nService.Instance}}" />

                        <!-- Token Input -->
                        <TextBlock Text="{Binding [CashRegisterAuthoriz], Source={x:Static services:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}"/>
                        <TextBox Classes="SettingsInput" Text="{Binding CashRegisterToken, Mode=TwoWay}" Watermark="{Binding [Entersecuretoken], Source={x:Static services:I18nService.Instance}}" PasswordChar="•" />

                        <!-- Language Input -->
                        <TextBlock Text="{Binding [LanguageЯзык], Source={x:Static services:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}"/>
                        <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" Classes="SettingsCombo"/>

                        <!-- Формат телефона: от него зависят маска ввода, предел нумпада
                             и код страны, который уходит на сервер. -->
                        <TextBlock Text="{Binding [PhoneFormat], Source={x:Static services:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}"/>
                        <ComboBox ItemsSource="{Binding AvailablePhoneFormats}" SelectedItem="{Binding SelectedPhoneFormat, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding DisplayName}" Classes="SettingsCombo"/>

                        <!-- Sync Interval Input -->
                        <TextBlock Text="{Binding [SyncIntervalMinutes], Source={x:Static services:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}"/>
                        <TextBox Classes="SettingsInput" Text="{Binding SyncIntervalText, Mode=TwoWay}" Watermark="{Binding [eg10], Source={x:Static services:I18nService.Instance}}" Margin="0,8,0,32"/>

                        <!-- Exchange payout category: the expense heading the till payout of an
                             exchange is filed under. The server requires one and has no default,
                             so the exchange button refuses while this is unset. -->
                        <TextBlock Text="{Binding [ExchangePayoutCategory], Source={x:Static services:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}"/>
                        <ComboBox ItemsSource="{Binding PaymentCategories}" SelectedItem="{Binding SelectedPaymentCategory, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding Name}" Classes="SettingsCombo"/>

                        <!-- Return payout category: same story for the returns screen, which
                             books its own till payout. Kept separate from the exchange one so
                             the two read as different lines in the expense report. -->
                        <TextBlock Text="{Binding [ReturnPayoutCategory], Source={x:Static services:I18nService.Instance}}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Slate700Brush}"/>
                        <ComboBox ItemsSource="{Binding PaymentCategories}" SelectedItem="{Binding SelectedReturnPaymentCategory, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding Name}" Classes="SettingsCombo"/>

                        <!-- Return Post-Action Toggles: read-only, showing what the register will
                             actually do — these are now decided by the server (see ReturnsViewModel /
                             SettingsViewModel's Effective properties), not by this checkbox. -->
                        <StackPanel Spacing="12" Margin="0,0,0,32">
                            <CheckBox IsChecked="{Binding ReturnOpenCashDrawerEffective}" IsEnabled="False"
                                      Content="{Binding [ReturnOpenDrawerSetting], Source={x:Static services:I18nService.Instance}}"/>
                            <CheckBox IsChecked="{Binding ReturnPrintReceiptEffective}" IsEnabled="False"
                                      Content="{Binding [ReturnPrintReceiptSetting], Source={x:Static services:I18nService.Instance}}"/>
                            <TextBlock Text="{Binding [ManagedInAdminHint], Source={x:Static services:I18nService.Instance}}"
                                       FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                        </StackPanel>

                        <!-- Printers Section Header -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                                <material:MaterialIcon Kind="Printer" Width="24" Height="24" Foreground="{StaticResource Slate700Brush}"/>
                                <TextBlock Text="{Binding [Printers], Source={x:Static services:I18nService.Instance}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Slate800Brush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="1" Classes="AddButton" Command="{Binding AddPrinterCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <material:MaterialIcon Kind="Plus" Width="20" Height="20"/>
                                    <TextBlock Text="{Binding [AddPrinter], Source={x:Static services:I18nService.Instance}}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Printers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                        <Grid ColumnDefinitions="*, *, *, Auto, Auto" RowDefinitions="Auto, Auto, Auto, Auto">
                                            <!-- Labels row -->
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Name], Source={x:Static services:I18nService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,8,4"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding [Type], Source={x:Static services:I18nService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,8,4"/>
                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ConnectionLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,8,4"/>
                                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding [Enabled], Source={x:Static services:I18nService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,8,4" HorizontalAlignment="Center"/>
                                            <!-- Inputs row -->
                                            <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" Classes="PrinterInput" Margin="0,0,8,0"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding $parent[UserControl].DataContext.ConnectionTypes}" SelectedItem="{Binding ConnectionType, Mode=TwoWay}" Classes="PrinterCombo" Margin="0,0,8,0"/>
                                            <Panel Grid.Row="1" Grid.Column="2" Margin="0,0,8,0">
                                                <TextBox Text="{Binding ConnectionString, Mode=TwoWay}" Classes="PrinterInput" IsVisible="{Binding IsLan}"/>
                                                <ComboBox ItemsSource="{Binding AvailableConnections}" SelectedItem="{Binding ConnectionString, Mode=TwoWay}" Classes="PrinterCombo" IsVisible="{Binding IsUsbOrCom}"/>
                                            </Panel>
                                            <CheckBox Grid.Row="1" Grid.Column="3" IsChecked="{Binding IsEnabled, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <Button Grid.Row="1" Grid.Column="4" Background="Transparent" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center"
                                                    Command="{Binding $parent[UserControl].DataContext.RemovePrinterCommand}"
                                                    CommandParameter="{Binding}">
                                                <material:MaterialIcon Kind="TrashCan" Width="20" Height="20"/>
                                            </Button>
                                            <!-- Кодовая страница и пробная печать — в третьей, ранее не занятой
                                                 строке, одним StackPanel с Grid.ColumnSpan="3" по звёздным колонкам
                                                 0–2, а не разложены по отдельным ячейкам в Auto-колонках 3 и 4, как
                                                 было раньше. Та раскладка растила Auto-бюджет с ~76px до ~472px
                                                 (ComboBox с именами вроде «PC437 — латиница (таблица по
                                                 умолчанию)» и кнопка с иконкой и подписью — каждая одна в своей
                                                 Auto-колонке), и на LAN-адрес в звёздных колонках оставалось ~45px
                                                 вместо ~177px при 700px MaxWidth панели. Колонки 3 и 4 здесь не
                                                 участвуют вовсе, поэтому по-прежнему меряются только CheckBox'ом и
                                                 кнопкой удаления выше — Auto-бюджет строки 1 не меняется. -->
                                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding [CodePage], Source={x:Static services:I18nService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" VerticalAlignment="Center"/>
                                                <ComboBox Width="220" ItemsSource="{Binding AvailableCodePages}" SelectedItem="{Binding SelectedCodePage, Mode=TwoWay}"
                                                          DisplayMemberBinding="{Binding DisplayName}" Classes="PrinterCombo"/>
                                                <!-- Пробная печать своя у каждой записи: кодовая страница задаётся на
                                                     принтер, и проверять надо именно её. Привязка через
                                                     $parent[UserControl].DataContext — тот же приём, что у кнопки
                                                     удаления выше; приводить DataContext предка к типу VM в XAML
                                                     нельзя, это компилируется и падает в рантайме. -->
                                                <Button VerticalAlignment="Center"
                                                        Command="{Binding $parent[UserControl].DataContext.TestPrintCommand}"
                                                        CommandParameter="{Binding}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <material:MaterialIcon Kind="Printer" Width="18" Height="18"/>
                                                        <TextBlock Text="{Binding [TestPrint], Source={x:Static services:I18nService.Instance}}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                            <!-- Роли принтера: какие документы на него уходят. Тремя
                                                 независимыми галками, а не одной ComboBox — принтер обычно
                                                 держит больше одной роли (например, чек и бегунок сразу). -->
                                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="16" Margin="0,8,0,0" VerticalAlignment="Center">
                                                <CheckBox Content="{Binding [PrintsReceipt], Source={x:Static services:I18nService.Instance}}" IsChecked="{Binding PrintsReceipt, Mode=TwoWay}"/>
                                                <CheckBox Content="{Binding [PrintsTicket], Source={x:Static services:I18nService.Instance}}" IsChecked="{Binding PrintsTicket, Mode=TwoWay}"/>
                                                <CheckBox Content="{Binding [PrintsKitchenOrder], Source={x:Static services:I18nService.Instance}}" IsChecked="{Binding PrintsKitchenOrder, Mode=TwoWay}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Дисплей покупателя. Одна кнопка проверки, а не по одной
                             на запись: дисплей на кассе один. -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,24,0,12">
                            <material:MaterialIcon Kind="CashRegister" Width="24" Height="24" Foreground="{StaticResource Slate700Brush}"/>
                            <TextBlock Text="{Binding [CustomerDisplay], Source={x:Static services:I18nService.Instance}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Slate800Brush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <Grid ColumnDefinitions="*, *, *, Auto" RowDefinitions="Auto, Auto">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [DisplayPort], Source={x:Static services:I18nService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,8,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding [DisplayBaudRate], Source={x:Static services:I18nService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,8,4"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding [CodePage], Source={x:Static services:I18nService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,8,4"/>

                                <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding AvailableDisplayPorts}" SelectedItem="{Binding CustomerDisplayPort, Mode=TwoWay}" Classes="PrinterCombo" Margin="0,0,8,0"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomerDisplayBaudRateText, Mode=TwoWay}" Classes="PrinterInput" Margin="0,0,8,0"/>
                                <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding AvailableCodePages}" SelectedItem="{Binding SelectedDisplayCodePage, Mode=TwoWay}"
                                          DisplayMemberBinding="{Binding DisplayName}" Classes="PrinterCombo" Margin="0,0,8,0"/>
                                <Button Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Command="{Binding CheckDisplayCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <material:MaterialIcon Kind="CheckCircle" Width="18" Height="18"/>
                                        <TextBlock Text="{Binding [CheckDisplay], Source={x:Static services:I18nService.Instance}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Очередь заказов и кухня (Task 24). Роль и номер кассы видны
                             всегда — номер кассы решает, из какого диапазона пула номеров
                             продаёт эта касса, и это касается и сервера тоже (он тоже
                             продаёт), поэтому поле не спрятано за условием роли. Адрес
                             сервера имеет смысл только у клиента; порт и секрет — только
                             у сервера (см. SettingsViewModel.IsQueueClientFieldsVisible /
                             IsQueueServerFieldsVisible). -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,24,0,12">
                            <material:MaterialIcon Kind="ServerNetwork" Width="24" Height="24" Foreground="{StaticResource Slate700Brush}"/>
                            <TextBlock Text="{Binding [QueueSettings], Source={x:Static services:I18nService.Instance}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Slate800Brush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [QueueRole], Source={x:Static services:I18nService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,8,4"/>
                                    <!-- Номер кассы — её класс вычетов в пуле номеров очереди.
                                         Виден всегда, не только у клиента: сервер тоже продаёт и
                                         тоже выдаёт номера из своего диапазона. Две кассы с
                                         одинаковым номером начнут выдавать покупателям
                                         одинаковые номера. -->
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding [TillNumber], Source={x:Static services:I18nService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,8,4"/>

                                    <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding QueueRoles}" SelectedItem="{Binding QueueRole, Mode=TwoWay}" Classes="PrinterCombo" Margin="0,0,8,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TillIndexText, Mode=TwoWay}" Classes="PrinterInput"/>
                                </Grid>

                                <StackPanel IsVisible="{Binding IsQueueClientFieldsVisible}">
                                    <TextBlock Text="{Binding [QueueServerAddress], Source={x:Static services:I18nService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding QueueServerAddress, Mode=TwoWay}" Classes="PrinterInput" Watermark="{Binding [QueueServerAddressWatermark], Source={x:Static services:I18nService.Instance}}"/>
                                </StackPanel>

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" IsVisible="{Binding IsQueueServerFieldsVisible}">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [QueuePort], Source={x:Static services:I18nService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,8,4"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding [QueueSecret], Source={x:Static services:I18nService.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,8,4"/>

                                    <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding QueuePortText, Mode=TwoWay}" Classes="PrinterInput" Margin="0,0,8,0"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding QueueSecret, Mode=TwoWay}" Classes="PrinterInput" PasswordChar="•"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Тот же баннер, что и внизу экрана, у той же пары свойств —
                             продублирован рендер, не состояние. Кнопка «Пробная печать»
                             живёт в этой карточке, а оба баннера были только под карточкой
                             локальных данных, за 200px нижнего отступа и без прокрутки к
                             результату: нажавший её ничего не видел. -->
                        <Border IsVisible="{Binding HasStatus}" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1"
                                CornerRadius="10" Padding="14,10" Margin="0,16,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <material:MaterialIcon Kind="CheckCircle" Width="20" Height="20" Foreground="#15803D" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding StatusMessage}" Foreground="#15803D" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border IsVisible="{Binding HasError}" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                                CornerRadius="10" Padding="14,10" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <material:MaterialIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#B91C1C" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

                <!-- Local Data Management Card -->
                <Border Background="White" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="16" Padding="32" BoxShadow="0 4 6 0 #0D000000, 0 2 4 0 #0A000000">
                    <StackPanel Spacing="16">
                        <!-- Section Header -->
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
                            <material:MaterialIcon Kind="DatabaseRemove" Width="24" Height="24" Foreground="{StaticResource DangerBrush}"/>
                            <StackPanel>
                                <TextBlock Text="{Binding [LocalDataManagement], Source={x:Static services:I18nService.Instance}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Slate800Brush}"/>
                                <TextBlock Text="{Binding [LocalDataManagementDesc], Source={x:Static services:I18nService.Instance}}" FontSize="13" Foreground="{StaticResource Slate500Brush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Clear Categories -->
                        <Border Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding [ClearCategories], Source={x:Static services:I18nService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Slate800Brush}"/>
                                    <TextBlock Text="{Binding [ClearCategoriesDesc], Source={x:Static services:I18nService.Instance}}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="DangerButton" Command="{Binding ClearCategoriesCommand}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <material:MaterialIcon Kind="TrashCan" Width="18" Height="18"/>
                                        <TextBlock Text="{Binding [ClearCategories], Source={x:Static services:I18nService.Instance}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Clear Products -->
                        <Border Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding [ClearProducts], Source={x:Static services:I18nService.Instance}}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Slate800Brush}"/>
                                    <TextBlock Text="{Binding [ClearProductsDesc], Source={x:Static services:I18nService.Instance}}" FontSize="12" Foreground="{StaticResource Slate500Brush}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="DangerButton" Command="{Binding ClearProductsCommand}" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <material:MaterialIcon Kind="TrashCan" Width="18" Height="18"/>
                                        <TextBlock Text="{Binding [ClearProducts], Source={x:Static services:I18nService.Instance}}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Успех проверки. Отдельно от красного баннера ниже: «Пробный чек
                     отправлен» в рамке с иконкой предупреждения читается как отказ. -->
                <Border IsVisible="{Binding HasStatus}" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <material:MaterialIcon Kind="CheckCircle" Width="20" Height="20" Foreground="#15803D" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#15803D" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Why the last Save was refused. Sits directly above the button that
                     refused, because a Save that quietly does nothing leaves the screen
                     showing values the register is not actually running on. -->
                <Border IsVisible="{Binding HasError}" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <material:MaterialIcon Kind="AlertCircleOutline" Width="20" Height="20" Foreground="#B91C1C" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Save Button -->
                <Button Classes="SaveButton" Command="{Binding SaveCommand}">                    <Button.ContentTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <material:MaterialIcon Kind="ContentSave" Width="24" Height="24"/>
                                <TextBlock Text="{Binding [SaveConfiguration], Source={x:Static services:I18nService.Instance}}" VerticalAlignment="Center" FontSize="18"/>
                            </StackPanel>
                        </DataTemplate>
                    </Button.ContentTemplate>
                </Button>

            </StackPanel>
        </ScrollViewer>

        <!-- Confirmation for the two destructive actions above. The buttons no longer act
             on a single tap: they arm the action and raise this. Uses the same heavier
             treatment PosView gives every genuinely destructive or blocking confirmation —
             shift close, park label, coupon, seller-switch approval — see PosView.axaml's
             Shift Close Confirm Modal, which this is deliberately styled after. An
             irreversible catalog wipe that leaves an offline register unable to sell
             deserves at least that weight. -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="#990f172a"
                IsVisible="{Binding IsConfirmVisible}"
                ZIndex="2000">
            <Border Background="White"
                    CornerRadius="24"
                    Padding="32"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 20 40 0 #40000000">
                <StackPanel Spacing="24">
                    <material:MaterialIcon Kind="AlertCircleOutline" Width="56" Height="56"
                                           Foreground="{StaticResource DangerBrush}"
                                           HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ConfirmMessage}"
                               FontSize="15"
                               Foreground="{StaticResource Slate700Brush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"/>
                    <Grid ColumnDefinitions="*, *">
                        <Button Grid.Column="0" Classes="BackButton" Margin="0,0,8,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="56"
                                Command="{Binding CancelConfirmCommand}"
                                Content="{Binding [Cancel], Source={x:Static services:I18nService.Instance}}"/>
                        <Button Grid.Column="1" Classes="DangerButton" Margin="8,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="56"
                                Command="{Binding ConfirmCommand}"
                                Content="{Binding [ConfirmDelete], Source={x:Static services:I18nService.Instance}}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
