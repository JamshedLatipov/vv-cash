<Window x:Name="RootWindow" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:VvCash.Services"
        xmlns:vm="using:VvCash.ViewModels"
        xmlns:models="clr-namespace:VvCash.Models.Api"
        xmlns:cart="using:VvCash.Models"
        xmlns:material="using:Material.Icons.Avalonia"
        x:Class="VvCash.Views.ExchangeWindow"
        x:DataType="vm:ExchangeViewModel"
        Title="Exchange"
        Width="1180" Height="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        CornerRadius="12"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

  <Window.Styles>
    <Style Selector="Border.scanned">
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </Window.Styles>

  <Border Background="White" CornerRadius="12" ClipToBounds="True" BoxShadow="0 20 25 -5 #40000000">
    <Grid RowDefinitions="Auto,*,Auto">

      <!-- Header -->
      <Border Grid.Row="0" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,0,0,1" Padding="32,24">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
            <material:MaterialIcon Kind="SwapHorizontal" Width="36" Height="36" Foreground="{StaticResource PrimaryBrush}"/>
            <TextBlock Text="{Binding [Exchange], Source={x:Static services:I18nService.Instance}}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" VerticalAlignment="Center"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="Transparent" Command="{Binding CloseCommand}" Padding="8" CornerRadius="99" Background="Transparent">
            <material:MaterialIcon Kind="Close" Width="24" Height="24" Foreground="{StaticResource Slate500Brush}"/>
          </Button>
        </Grid>
      </Border>

      <!-- Body: sales list | returned lines | issued lines -->
      <Grid Grid.Row="1" ColumnDefinitions="300,*,*">

        <!-- Left: the one receipt being exchanged against.

             There is deliberately no browsable list of sales here. This screen pays the
             whole returned total out of the till, so a cashier able to page through every
             receipt the register ever rang could pick an arbitrary one and move drawer
             money against it. A receipt number has to come off a slip the customer
             actually handed over. -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="24,16">

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0" Text="{Binding DocumentNumberQuery}" Classes="IconTextBox"
                     Watermark="{Binding [SearchByReceiptNumber], Source={x:Static services:I18nService.Instance}}"
                     FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0">
              <TextBox.InnerLeftContent>
                <material:MaterialIcon Kind="Receipt" Width="18" Height="18" Foreground="{StaticResource Slate400Brush}" Margin="10,0,8,0"/>
              </TextBox.InnerLeftContent>
            </TextBox>
            <Button Grid.Column="1" Classes="PrimaryButton" Command="{Binding SearchSaleCommand}" VerticalAlignment="Center" Padding="12,8">
              <material:MaterialIcon Kind="Magnify" Width="18" Height="18"/>
            </Button>
          </Grid>

          <!-- The receipt that was found, so the cashier can see they matched the right
               slip before moving any money against it. -->
          <Border Grid.Row="1" IsVisible="{Binding HasSelectedSale}"
                  Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}"
                  BorderThickness="1" CornerRadius="8" Padding="14">
            <Grid ColumnDefinitions="*,Auto" DataContext="{Binding SelectedSale}" x:DataType="models:ExpenseListItem">
              <StackPanel Grid.Column="0">
                <TextBlock FontSize="15" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}">
                  <Run Text="#"/><Run Text="{Binding DocumentNumber}"/>
                </TextBlock>
                <TextBlock Text="{Binding Creator}" FontSize="12" Foreground="{StaticResource Slate600Brush}"/>
                <TextBlock Text="{Binding FormattedSelectedDate}" FontSize="11" Foreground="{StaticResource Slate500Brush}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding ToPay, StringFormat='{}{0:N2}'}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
            </Grid>
          </Border>

          <TextBlock Grid.Row="2" IsVisible="{Binding !HasSelectedSale}"
                     Text="{Binding [SelectSaleToExchange], Source={x:Static services:I18nService.Instance}}"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                     FontSize="15" Foreground="{StaticResource Slate400Brush}"/>

          <Button Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,12,0,0"
                  Classes="OutlinedButton" Command="{Binding ClearSearchCommand}"
                  IsVisible="{Binding HasSelectedSale}"
                  Content="{Binding [Clear], Source={x:Static services:I18nService.Instance}}"/>
        </Grid>

        <!-- Middle: returned lines -->
        <Border Grid.Column="1" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1,0,0,0" Padding="20,16">
          <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Grid.Row="0" Text="{Binding [RefundTotal], Source={x:Static services:I18nService.Instance}}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,8"/>
            <TextBox Grid.Row="1" x:Name="ReturnScanBox" Text="{Binding ReturnScanQuery}" Classes="IconTextBox"
                     Watermark="{Binding [ScanReturnItem], Source={x:Static services:I18nService.Instance}}"
                     FontSize="14" Margin="0,0,0,12" IsEnabled="{Binding HasSelectedSale}"
                     KeyDown="OnReturnScanKeyDown">
              <TextBox.InnerLeftContent>
                <material:MaterialIcon Kind="BarcodeScan" Width="18" Height="18" Foreground="{StaticResource Slate400Brush}" Margin="10,0,8,0"/>
              </TextBox.InnerLeftContent>
            </TextBox>
            <Grid Grid.Row="2">
              <TextBlock Text="{Binding [SelectSaleToExchange], Source={x:Static services:I18nService.Instance}}" IsVisible="{Binding !HasSelectedSale}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource Slate400Brush}" TextWrapping="Wrap"/>
              <!-- Scrolled since the cards carry the sale's own figures and are several
                   lines tall: a long receipt would otherwise run off the bottom of the
                   column with no way to reach the lines below. -->
              <ScrollViewer IsVisible="{Binding HasSelectedSale}">
              <ItemsControl ItemsSource="{Binding ReturnedLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ReturnLineVm">
                    <Border Classes.scanned="{Binding IsRecentlyScanned}" Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4" IsEnabled="{Binding IsReturnable}">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <!-- The picture, matched out of the register's own catalog since the
                             receipt endpoint carries none. A name and an article identify a
                             line to the back office; the cashier is holding the thing. -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Margin="0,0,10,0"
                                Background="{StaticResource Slate100Brush}" BorderBrush="{StaticResource Slate200Brush}"
                                BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                          <Panel>
                            <material:MaterialIcon Kind="ImageOutline" Width="20" Height="20" Foreground="{StaticResource Slate400Brush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   IsVisible="{Binding ImageBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                            <Image Source="{Binding ImageBitmap}" Stretch="UniformToFill"
                                   IsVisible="{Binding ImageBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                          </Panel>
                        </Border>
                        <!-- Everything the cashier needs to tell this line apart from a
                             lookalike on the shelf (article, barcode) and to see what the
                             customer actually paid for it, which is what comes back out of
                             the till. The discount row appears only when the sale was
                             discounted: the register cannot name the promotion — the API
                             records it on the document, not on the line — so the card shows
                             the percent and the money that came off instead. -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}"/>

                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock FontSize="11" Foreground="{StaticResource Slate500Brush}" IsVisible="{Binding HasArticle}">
                              <Run Text="{Binding [Article], Source={x:Static services:I18nService.Instance}}"/><Run Text=": "/><Run Text="{Binding Article}"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{StaticResource Slate500Brush}" IsVisible="{Binding HasBarcode}">
                              <Run Text="{Binding [Barcode], Source={x:Static services:I18nService.Instance}}"/><Run Text=": "/><Run Text="{Binding Barcode}"/>
                            </TextBlock>
                          </StackPanel>

                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock FontSize="11" Foreground="{StaticResource Slate500Brush}">
                              <Run Text="{Binding [SoldQty], Source={x:Static services:I18nService.Instance}}"/><Run Text=": "/><Run Text="{Binding SoldQty}"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{StaticResource Slate600Brush}">
                              <Run Text="{Binding [Paid], Source={x:Static services:I18nService.Instance}}"/><Run Text=": "/><Run Text="{Binding PaidTotal, StringFormat='{}{0:N2}'}"/>
                            </TextBlock>
                          </StackPanel>

                          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasDiscount}">
                            <TextBlock FontSize="11" Foreground="{StaticResource Red500Brush}">
                              <Run Text="{Binding [Discount], Source={x:Static services:I18nService.Instance}}"/><Run Text=": "/><Run Text="{Binding DiscountPercent, StringFormat='{}{0:0.##}%'}"/><Run Text=" (−"/><Run Text="{Binding LineDiscount, StringFormat='{}{0:N2}'}"/><Run Text=")"/>
                            </TextBlock>
                            <TextBlock FontSize="11" Foreground="{StaticResource Slate500Brush}">
                              <Run Text="{Binding [PriceBeforeDiscount], Source={x:Static services:I18nService.Instance}}"/><Run Text=": "/><Run Text="{Binding SoldPrice, StringFormat='{}{0:N2}'}"/>
                            </TextBlock>
                          </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                          <Button Classes="OutlinedButton" Command="{Binding DecrementCommand}" Padding="6,2"><TextBlock Text="−"/></Button>
                          <TextBlock Text="{Binding ReturnQty}" FontSize="15" FontWeight="Bold" MinWidth="24" TextAlignment="Center" VerticalAlignment="Center"/>
                          <Button Classes="OutlinedButton" Command="{Binding IncrementCommand}" Padding="6,2"><TextBlock Text="+"/></Button>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding LineRefund, StringFormat='{}{0:N2}'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" MinWidth="60" TextAlignment="Right"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Border>

        <!-- Right: goods being issued -->
        <Border Grid.Column="2" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="1,0,0,0" Padding="20,16">
          <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Grid.Row="0" Text="{Binding [IssuedGoods], Source={x:Static services:I18nService.Instance}}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource Slate500Brush}" Margin="0,0,0,8"/>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12" IsEnabled="{Binding HasSelectedSale}">
              <TextBox Grid.Column="0" x:Name="IssuedSearchBox" Text="{Binding IssuedSearchQuery}" Classes="IconTextBox"
                       Watermark="{Binding [SearchProductToIssue], Source={x:Static services:I18nService.Instance}}"
                       FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"
                       KeyDown="OnIssuedSearchKeyDown">
                <TextBox.InnerLeftContent>
                  <material:MaterialIcon Kind="Magnify" Width="18" Height="18" Foreground="{StaticResource Slate400Brush}" Margin="10,0,8,0"/>
                </TextBox.InnerLeftContent>
              </TextBox>
              <Button Grid.Column="1" Classes="PrimaryButton" Command="{Binding AddIssuedProductCommand}" VerticalAlignment="Center" Padding="12,8">
                <material:MaterialIcon Kind="Plus" Width="18" Height="18"/>
              </Button>
            </Grid>

            <!-- Scrolled for the same reason the returned column is: the cards carry a
                 thumbnail and a discount row now, so a handful of them runs off the bottom
                 with no way to reach the lines below. -->
            <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding IssuedLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="cart:CartItem">
                  <Border Background="{StaticResource Slate50Brush}" BorderBrush="{StaticResource Slate200Brush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Margin="0,0,10,0"
                              Background="{StaticResource Slate100Brush}" BorderBrush="{StaticResource Slate200Brush}"
                              BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                        <Panel>
                          <material:MaterialIcon Kind="ImageOutline" Width="20" Height="20" Foreground="{StaticResource Slate400Brush}"
                                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                                 IsVisible="{Binding Product.ImageBitmap, Converter={x:Static ObjectConverters.IsNull}}"/>
                          <Image Source="{Binding Product.ImageBitmap}" Stretch="UniformToFill"
                                 IsVisible="{Binding Product.ImageBitmap, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        </Panel>
                      </Border>

                      <!-- The badge and the discount row show only once the server has
                           actually priced this line down. Without them the card read at the
                           catalog price with the promotion visible nowhere but the footer's
                           single total, so a cashier could not tell which of the replacement
                           goods the discount had come off. -->
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Text="{Binding Product.Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          <Border IsVisible="{Binding HasLineDiscount}" Background="{StaticResource Red100Brush}" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding QuotedDiscountPercent, StringFormat='-{0:0.##}%'}" Foreground="{StaticResource Red600Brush}" FontSize="10" FontWeight="Black"/>
                          </Border>
                        </StackPanel>
                        <TextBlock FontSize="11" Foreground="{StaticResource Red500Brush}" IsVisible="{Binding HasLineDiscount}">
                          <Run Text="{Binding [Discount], Source={x:Static services:I18nService.Instance}}"/><Run Text=": −"/><Run Text="{Binding LineDiscount, StringFormat='{}{0:N2}'}"/>
                        </TextBlock>
                      </StackPanel>

                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Button Classes="QtyButton" Width="26" Height="26" FontSize="14" CornerRadius="8"
                                Command="{Binding DataContext.DecrementIssuedCommand, ElementName=RootWindow}"
                                CommandParameter="{Binding}" Content="-"/>
                        <TextBlock Text="{Binding QuantityDisplay}" FontSize="15" FontWeight="Bold" MinWidth="24" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button Classes="QtyButton" Width="26" Height="26" FontSize="14" CornerRadius="8"
                                Command="{Binding DataContext.IncrementIssuedCommand, ElementName=RootWindow}"
                                CommandParameter="{Binding}" Content="+"/>
                      </StackPanel>

                      <!-- What this line actually costs, with the pre-discount figure struck
                           through above it — the same shape the sale's own totals take, so
                           the cards add up to the issued total rather than past it. -->
                      <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="60">
                        <TextBlock Text="{Binding LineTotal, StringFormat='{}{0:N2}'}" FontSize="11" Foreground="{StaticResource Slate400Brush}"
                                   TextDecorations="Strikethrough" TextAlignment="Right" IsVisible="{Binding HasLineDiscount}"/>
                        <TextBlock Text="{Binding LineFinalTotal, StringFormat='{}{0:N2}'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" TextAlignment="Right"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- Footer -->
      <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Slate100Brush}" BorderThickness="0,1,0,0" Padding="32,20">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Red500Brush}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource PrimaryBrush}" IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding [ExchangeOfflineWarning], Source={x:Static services:I18nService.Instance}}" Foreground="{StaticResource Red500Brush}" IsVisible="{Binding !IsOnline}"/>
            <TextBlock Text="{Binding [ExchangePayoutCategoryWarning], Source={x:Static services:I18nService.Instance}}" Foreground="{StaticResource Red500Brush}" IsVisible="{Binding !IsPayoutCategoryConfigured}"/>

            <StackPanel Orientation="Horizontal" Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding [ExchangeReturnedLabel], Source={x:Static services:I18nService.Instance}}" FontSize="13" Foreground="{StaticResource Slate600Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ReturnedTotal, StringFormat='{}{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding [ExchangeIssuedLabel], Source={x:Static services:I18nService.Instance}}" FontSize="13" Foreground="{StaticResource Slate600Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding IssuedTotal, StringFormat='{}{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Slate900Brush}"/>
              </StackPanel>
              <!-- Only when the server actually discounted the replacement goods: the
                   lines above read at their catalog price, exactly like the POS cart, so
                   without this row a promotion would be invisible and the issued total
                   would look wrong rather than discounted. -->
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasIssuedDiscount}">
                <TextBlock Text="{Binding [TotalDiscount], Source={x:Static services:I18nService.Instance}}" FontSize="13" Foreground="{StaticResource Red500Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding IssuedDiscount, StringFormat='-{0:N2}'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Red500Brush}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding CustomerPays}">
                <TextBlock Text="{Binding [ExchangeCustomerPaysLabel], Source={x:Static services:I18nService.Instance}}" FontSize="13" Foreground="{StaticResource Slate600Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Difference, StringFormat='{}{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding TillPays}">
                <TextBlock Text="{Binding [ExchangeRefundDueLabel], Source={x:Static services:I18nService.Instance}}" FontSize="13" Foreground="{StaticResource Slate600Brush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding RefundDue, StringFormat='{}{0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" Classes="PrimaryButton" Command="{Binding SubmitExchangeCommand}" IsEnabled="{Binding CanSubmit}" MinWidth="180" HorizontalContentAlignment="Center">
            <TextBlock Text="{Binding [ExchangeAction], Source={x:Static services:I18nService.Instance}}"/>
          </Button>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
